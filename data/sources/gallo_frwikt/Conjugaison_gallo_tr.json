/>je <bdi lang=\"gallo\" class=\"lang-gallo\"><a href=\"/wiki/somes#gallo\" title=\"somes\">somes</a></bdi>*\n</td>\n<td>j\u2019ons et\u00eb<br />j\u2019avons et\u00eb\n</td></tr>\n<tr align=\"center\">\n<td>vous / v'<bdi lang=\"gallo\" class=\"lang-gallo\"><a href=\"/wiki/etes#gallo\" title=\"etes\">etes</a></bdi>*\n</td>\n<td>v\u2019\u00e9z et\u00eb <br />vous / v'av\u00e9z et\u00eb\n</td></tr>\n<tr align=\"center\" bgcolor=\"#efefef\">\n<td>i  <bdi lang=\"gallo\" class=\"lang-gallo\"><a href=\"/wiki/sont#gallo\" title=\"sont\">sont</a></bdi>\n</td>\n<td>il ont et\u00eb<br />il avont et\u00eb\n</td></tr>\n<tr>\n<td>&#160;\n</td></tr>\n<tr align=\"center\">\n<th width=\"50%\" bgcolor=\"#DDDDDD\" style=\"border-bottom:1px solid #aaaaaa;\">Imparfait\n</th>\n<td rowspan=\"7\">&#160;\n</td>\n<th width=\"50%\" bgcolor=\"#DFDFFF\" style=\"border-bottom:1px solid #aaaaaa;\">Plus-que-parfait\n</th></tr>\n<tr align=\"center\">\n<td>j'<bdi lang=\"gallo\" class=\"lang-gallo\"><a href=\"/wiki/etaes#gallo\" title=\"etaes\">etaes</a></bdi>\n</td>\n<td>j'avaes et\u00eb\n</td></tr>\n<tr align=\"center\" bgcolor=\"#efefef\">\n<td>t'<bdi lang=\"gallo\" class=\"lang-gallo\"><a href=\"/wiki/etaes#gallo\" title=\"etaes\">etaes</a></bdi>\n</td>\n<td>t'avaes et\u00eb\n</td></tr>\n<tr align=\"center\">\n<td>il <bdi lang=\"gallo\" class=\"lang-gallo\"><a href=\"/wiki/etaet#gallo\" title=\"etaet\">etaet</a></bdi>\n</td>\n<td>il avaet et\u00eb\n</td></tr>\n<tr align=\"center\" bgcolor=\"#efefef\">\n<td>j'<bdi lang=\"gallo\" class=\"lang-gallo\"><a href=\"/wiki/etions#gallo\" title=\"etions\">etions</a></bdi>\n</td>\n<td>j'avins et\u00eb<br />j'avions et\u00eb\n</td></tr>\n<tr align=\"center\">\n<td>vous <bdi lang=\"gallo\" class=\"lang-gallo\"><a href=\"/wiki/eti%C3%A9z#gallo\" title=\"eti\u00e9z\">eti\u00e9z</a></bdi>\n</td>\n<td>vous avi\u00e9z et\u00eb\n</td></tr>\n<tr align=\"center\" bgcolor=\"#efefef\">\n<td>il <bdi lang=\"gallo\" class=\"lang-gallo\"><a href=\"/wiki/etaent#gallo\" title=\"etaent\">etaent</a></bdi>\n</td>\n<td>il avaent et\u00eb\n</td></tr>\n<tr>\n<td>&#160;\n</td></tr>\n<tr align=\"center\">\n<th width=\"50%\" bgcolor=\"#DDDDDD\" style=\"border-bottom:1px solid #aaaaaa;\">Pass\u00e9 simple\n</th>\n<td rowspan=\"7\">&#160;\n</td>\n<th width=\"50%\" bgcolor=\"#DFDFFF\" style=\"border-bottom:1px solid #aaaaaa;\">Pass\u00e9 ant\u00e9rieur\n</th></tr>\n<tr align=\"center\">\n<td>je <bdi lang=\"gallo\" class=\"lang-gallo\"><a href=\"/wiki/fus#gallo\" title=\"fus\">fus</a></bdi>\n</td>\n<td>j'\u00fbs et\u00eb\n</td></tr>\n<tr align=\"center\" bgcolor=\"#efefef\">\n<td>tu <bdi lang=\"gallo\" class=\"lang-gallo\"><a href=\"/wiki/fus#gallo\" title=\"fus\">fus</a></bdi>\n</td>\n<td>t'\u00fbs et\u00eb\n</td></tr>\n<tr align=\"center\">\n<td>il <bdi lang=\"gallo\" class=\"lang-gallo\"><a href=\"/wiki/fut#gallo\" title=\"fut\">fut</a></bdi>\n</td>\n<td>il \u00fbt et\u00eb\n</td></tr>\n<tr align=\"center\" bgcolor=\"#efefef\">\n<td>je <bdi lang=\"gallo\" class=\"lang-gallo\"><a href=\"/wiki/fute#gallo\" title=\"fute\">fute</a></bdi><br />je <bdi lang=\"gallo\" class=\"lang-gallo\"><a href=\"/wiki/fume#gallo\" title=\"fume\">fume</a></bdi>\n</td>\n<td>j'\u00fbte et\u00eb<br />j'\u00fbme et\u00eb\n</td></tr>\n<tr align=\"center\">\n<td>vous <bdi lang=\"gallo\" class=\"lang-gallo\"><a href=\"/wiki/fute#gallo\" title=\"fute\">fute</a></bdi>\n</td>\n<td>vous \u00fbte et\u00eb\n</td></tr>\n<tr align=\"center\" bgcolor=\"#efefef\">\n<td>i <bdi lang=\"gallo\" class=\"lang-gallo\"><a href=\"/wiki/fute#gallo\" title=\"fute\">fute</a></bdi><br />i <bdi lang=\"gallo\" class=\"lang-gallo\"><a href=\"/wiki/furent#gallo\" title=\"furent\">furent</a></bdi>\n</td>\n<td>il \u00fbte et\u00eb<br />il \u00fbrent et\u00eb\n</td></tr>\n<tr>\n<td>&#160;\n</td></tr>\n<tr align=\"center\">\n<th width=\"50%\" bgcolor=\"#DDDDDD\" style=\"border-bottom:1px solid #aaaaaa;\">Futur simple\n</th>\n<td rowspan=\"7\">&#160;\n</td>\n<th width=\"50%\" bgcolor=\"#DFDFFF\" style=\"